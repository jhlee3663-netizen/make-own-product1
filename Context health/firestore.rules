rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /logs/{docId} {
      allow read, write: if request.auth != null;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/coachRooms/{roomId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
